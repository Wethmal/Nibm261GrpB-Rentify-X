{
  "name": "Rentify-server",
  "version": "1.0.0",
  "description": "Rentify backend — Express.js REST API with PostgreSQL, JWT authentication, Cloudinary uploads, and escrow-based payment integration for the Sri Lankan rental & services marketplace.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:export": "node db/export_db.js",
    "migrate": "node db/migrate.js",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.12.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "verbose": true
  },
  "keywords": [
    "Rentify",
    "api",
    "express",
    "postgresql"
  ],
  "author": "Rentify Engineering Team",
  "license": "UNLICENSED"
}