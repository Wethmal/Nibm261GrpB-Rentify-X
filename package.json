{
  "name": "Rentify",
  "version": "1.0.0",
  "description": "Rentify — A trusted rental and services marketplace platform for Sri Lanka. Monorepo root containing client (React/Vite) and server (Express/PostgreSQL) workspaces.",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev",
    "test": "concurrently \"npm run test:server\" \"npm run test:client\"",
    "test:server": "cd server && npm test",
    "test:client": "cd client && npm test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "Rentify",
    "marketplace",
    "sri-lanka",
    "rental",
    "services",
    "booking"
  ],
  "author": "Rentify Engineering Team",
  "license": "UNLICENSED"
}