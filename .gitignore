# ============================================================
# @file       .gitignore
# @purpose    Version control exclusion rules
# @description
#   Defines files and directories to exclude from Git tracking.
#   Covers Node.js dependencies, environment secrets, build outputs,
#   OS-generated files, IDE configurations, and upload directories.
# ============================================================

# --- Dependencies ---
node_modules/

# --- Environment Variables ---
.env
.env.local
.env.development
.env.production

# --- Build Outputs ---
dist/
build/

# --- Uploads (local dev only — production uses Cloudinary) ---
uploads/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS Generated Files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- IDE / Editor Configs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Coverage Reports ---
coverage/
.nyc_output/

# --- Miscellaneous ---
*.tgz
.eslintcache
