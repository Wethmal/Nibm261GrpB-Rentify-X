# ============================================================
# @file       .env.example
# @purpose    Client environment variable template
# @description
#   Template for Regal client environment variables. Copy this
#   file to .env and fill in the values. All variables must be
#   prefixed with VITE_ to be exposed to the client bundle.
#   VITE_API_BASE_URL points to the backend API server.
# ============================================================

# --- API Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api/v1

# --- Application ---
VITE_APP_NAME=Regal

# --- Cloudinary (client-side unsigned uploads if needed) ---
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAdsvZ2PMYO5KpHg4rr0oYJg4UnA2S633Y
